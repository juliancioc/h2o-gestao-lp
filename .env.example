# Container do Google Tag Manager. GA4 e Meta Pixel são TAGS dentro dele, nunca
# scripts soltos no código: instalar de novo aqui duplicaria cada pageview.
# Vazio (ou ausente) desliga o carregamento do container, e os eventos ficam só
# no dataLayer, visíveis no console em desenvolvimento.
VITE_GTM_ID=GTM-MN262DRF

# Id do pixel do Meta. Não instala nada sozinho: vai para o dataLayer para o
# container usar como variável, em vez de ter o número escrito dentro da tag.
VITE_META_PIXEL_ID=440452242149710

# Ambiente do DADO (não do build), carimbado em todo evento. O container usa
# para não deixar teste local e staging entrarem na conta de produção do
# GA4/Meta. Valores: development | staging | production.
# Sem esta variável, build de produção assume "production" e o resto
# "development".
VITE_ANALYTICS_ENV=development
